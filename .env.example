# Copy to .env and fill in. Never commit the real .env.

# --- Groq (LLM: extraction, entity resolution, relationship reasoning, answer planning, vision fallback) ---
GROQ_API_KEY=
# Large-context, free-tier Groq model. Verify current availability at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Vision-capable Groq model, used only for pages native/OCR extraction can't handle reliably.
GROQ_VISION_MODEL=

# --- Postgres (system of record) ---
DATABASE_URL=postgres://groundwork:groundwork@localhost:5433/groundwork

# --- Neo4j (graph projection layer) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=groundwork123

# --- Local embedding model (sentence-transformers, downloaded on first run) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Service ports ---
CORE_PORT=8080
INTELLIGENCE_PORT=8000
WEB_PORT=3000
INTELLIGENCE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_ANSWER_MODEL=openai/gpt-oss-20b
